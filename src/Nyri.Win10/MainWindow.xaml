<Window x:Class="Nyri.Win10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Foreground="{DynamicResource OnSurfaceBrush}" Title="NYRI-WIN10"
        Width="260"
        Height="70"
        MinWidth="260"
        MinHeight="70"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Border x:Name="IslandBorder"
                Margin="10"
                Padding="12,8"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="25"
                Cursor="Hand"
                MouseLeftButtonDown="Island_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="4"
                                  Opacity="0.45"
                                  Color="#000000"/>
            </Border.Effect>            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="26"
                            Height="26"
                            CornerRadius="13"
                            Background="{DynamicResource PrimaryBrush}"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="StatusGlyph"
                                   Text="●"
                                   Foreground="{DynamicResource OnPrimaryBrush}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="8,0,8,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="NYRI"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>                        <TextBlock x:Name="DetailText"
                                   Text="Windows live island"
                                   FontSize="10"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="MicrophoneIndicator" Text="&#xE720;" FontFamily="Segoe MDL2 Assets" Foreground="#FF9EE6B0" Margin="0,0,5,0" Visibility="Collapsed" ToolTip="Windows сообщает об использовании микрофона"/>
                        <TextBlock x:Name="CameraIndicator" Text="&#xE714;" FontFamily="Segoe MDL2 Assets" Foreground="#FF9EE6B0" Margin="0,0,5,0" Visibility="Collapsed" ToolTip="Windows сообщает об использовании камеры"/>
                    <TextBlock x:Name="ClockText"
                               Grid.Column="2"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ExpandedPanel"
                      Grid.Row="1"
                      Margin="0,12,0,0"
                      Visibility="Collapsed"
                      Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#33FFFFFF"
                            Height="1"
                            HorizontalAlignment="Stretch"/>

                    <ScrollViewer Grid.Row="1" MaxHeight="100"
                                  Margin="0,8,0,4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ActivityList">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,5"
                                        Margin="0,2"
                                        CornerRadius="10"
                                        Background="#10FFFFFF">                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}"
                                                   FontSize="14" FontFamily="Segoe UI, Segoe MDL2 Assets"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="MediaControls"
                                Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,8"
                                Visibility="Collapsed">
                        <Button Style="{DynamicResource MediaButtonStyle}"
                                Content="⏮"
                                ToolTip="Предыдущий трек"
                                Click="MediaPrevious_Click"/>
                        <Button Style="{DynamicResource MediaButtonStyle}"
                                Content="⏯"
                                ToolTip="Play / Pause"
                                Click="MediaPlayPause_Click"/>
                        <Button Style="{DynamicResource MediaButtonStyle}"
                                Content="⏭"
                                ToolTip="Следующий трек"
                                Click="MediaNext_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,8">
                        <Button Style="{DynamicResource MediaButtonStyle}"
                                Content="5m"
                                ToolTip="Таймер на 5 минут"
                                Click="StartFiveMinuteTimer_Click"/>
                        <Button Style="{DynamicResource MediaButtonStyle}"
                                Content="⏱"
                                ToolTip="Старт / стоп секундомера"
                                Click="ToggleStopwatch_Click"/>
                        <Button Style="{DynamicResource MediaButtonStyle}"
                                Content="■"
                                ToolTip="Остановить таймер"
                                Click="StopTimer_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4"
                               Text="SHIFT + drag  •  CTRL+R центр  •  ESC свернуть  •  CTRL+Q выход"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="9"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
