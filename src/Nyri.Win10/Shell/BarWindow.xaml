<Window x:Class="Nyri.Win10.Shell.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource ShellWindowStyle}"
        Foreground="{DynamicResource OnSurfaceBrush}" Title="NYRI — панель" Height="64" Width="1200" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged" Closed="Window_Closed">
    <Border Background="{DynamicResource SurfaceContainerLowestBrush}" Padding="12,8" CornerRadius="0,0,20,20">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="&#xE80F;" FontFamily="Segoe MDL2 Assets" Style="{DynamicResource ShellIconButtonStyle}" ToolTip="Поиск приложений · Ctrl+Alt+Space" Click="Launcher_Click" AutomationProperties.Name="Открыть поиск приложений"/>
                <Button x:Name="BrandBadge" Content="NYRI" Style="{DynamicResource TonalButtonStyle}" Background="{DynamicResource PrimaryContainerBrush}" Foreground="{DynamicResource OnPrimaryContainerBrush}" FontWeight="Bold" Padding="14,7" Margin="8,0,12,0" Click="Launcher_Click" ToolTip="Все приложения"/>
                <TextBlock x:Name="WindowTitleText" MaxWidth="230" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="LiveButton" Grid.Column="1" Style="{DynamicResource TonalButtonStyle}" Padding="16,4" MinWidth="260" MaxWidth="480" Click="Live_Click" ToolTip="Активности, музыка и таймеры">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockText" FontWeight="Bold" FontSize="14" Margin="0,0,12,0"/>
                    <TextBlock x:Name="ActivityGlyph" Text="◆" FontFamily="Segoe UI, Segoe MDL2 Assets" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ActivityTitle" Text="NYRI готов" FontSize="12" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MicrophoneText" Text="&#xE720;" FontFamily="Segoe MDL2 Assets" Margin="8,0,0,0" Visibility="Collapsed" ToolTip="Микрофон используется"/>
                    <TextBlock x:Name="CameraText" Text="&#xE714;" FontFamily="Segoe MDL2 Assets" Margin="8,0,0,0" Visibility="Collapsed" ToolTip="Камера используется"/>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="DateText" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="8,0,12,0" VerticalAlignment="Center"/>
                <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Style="{DynamicResource ShellIconButtonStyle}" Click="Settings_Click" ToolTip="Настройки NYRI · Ctrl+Alt+I" AutomationProperties.Name="Настройки NYRI"/>
                <Button Content="&#xE9E9;" FontFamily="Segoe MDL2 Assets" Style="{DynamicResource FilledButtonStyle}" Click="Control_Click" ToolTip="Шторка · Ctrl+Alt+N" AutomationProperties.Name="Открыть шторку"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
