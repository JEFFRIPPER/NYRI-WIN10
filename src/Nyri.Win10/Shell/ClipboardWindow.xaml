<Window x:Class="Nyri.Win10.Shell.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource ShellWindowStyle}"
        Foreground="{DynamicResource OnSurfaceBrush}" Title="NYRI — буфер обмена"
        Width="620" Height="560" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        Loaded="Window_Loaded" Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Style="{DynamicResource ShellCardStyle}" Padding="20" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Буфер обмена" Style="{DynamicResource TitleLargeTextStyle}"/>
                    <TextBlock x:Name="CountText" Text="История отключена" Style="{DynamicResource BodySmallTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="ClearButton" Grid.Column="1" Content="Очистить" Style="{DynamicResource OutlinedButtonStyle}"
                        Padding="12,8" MinHeight="36" FontSize="12" IsEnabled="False" Click="Clear_Click" Margin="8,0" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="×" Style="{DynamicResource ShellIconButtonStyle}" Click="Close_Click"
                        VerticalAlignment="Center" AutomationProperties.Name="Закрыть историю буфера обмена"/>
            </Grid>
            <TextBox x:Name="SearchBox" Grid.Row="1" Style="{DynamicResource ShellTextBoxStyle}" MinHeight="44" FontSize="14"
                     IsEnabled="False" TextChanged="Search_TextChanged" Margin="0,0,0,16"
                     ToolTip="Поиск по полному тексту записи" AutomationProperties.Name="Поиск по полному тексту истории буфера обмена"/>

            <Border x:Name="DisabledPane" Grid.Row="2" Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="20" Padding="28">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="История буфера отключена" Style="{DynamicResource TitleMediumTextStyle}" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="После включения NYRI будет запоминать скопированный текст. Записи хранятся только в памяти до выхода из NYRI."
                               Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,20"/>
                    <Button Content="Включить историю" Style="{DynamicResource FilledButtonStyle}" Click="Enable_Click" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border x:Name="EmptyPane" Grid.Row="2" Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="20" Padding="28" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyTitleText" Text="История пока пуста" Style="{DynamicResource TitleMediumTextStyle}" TextAlignment="Center"/>
                    <TextBlock x:Name="EmptyDetailText" Text="Скопируй текст в любом приложении — он появится здесь."
                               Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <Grid x:Name="EntriesContent" Grid.Row="2" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                <ListBox x:Name="EntriesList" Background="Transparent" Foreground="{DynamicResource OnSurfaceBrush}"
                         BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="Entries_SelectionChanged" AutomationProperties.Name="Скопированные записи">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
                            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="EntryBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="16">
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceContainerHighestBrush}"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryContainerBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainerBrush}"/></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="EntryBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Preview}" FontWeight="Medium" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                            <TextBlock Text="{Binding DisplayTime}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Полный текст" Style="{DynamicResource LabelLargeTextStyle}" Margin="0,0,0,8"/>
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceContainerLowestBrush}" CornerRadius="16" Padding="12">
                        <TextBox x:Name="DetailTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 Background="Transparent" Foreground="{DynamicResource OnSurfaceBrush}" FontSize="13" BorderThickness="0"
                                 SelectionBrush="{DynamicResource PrimaryContainerBrush}" CaretBrush="{DynamicResource PrimaryBrush}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Полный текст выбранной записи">
                            <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost"/></ControlTemplate></TextBox.Template>
                        </TextBox>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="CopyButton" Content="Копировать" Style="{DynamicResource FilledButtonStyle}" Padding="8,10" FontSize="12" Click="Copy_Click"/>
                        <Button x:Name="RemoveButton" Grid.Column="2" Content="Удалить" Style="{DynamicResource ShellButtonStyle}" Padding="8,10" FontSize="12" Click="Remove_Click"/>
                    </Grid>
                </Grid>
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="3" Text="История отключена." Foreground="{DynamicResource MutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
        </Grid>
    </Border>
</Window>
