<Window x:Class="Nyri.Win10.Shell.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource ShellWindowStyle}"
        Foreground="{DynamicResource OnSurfaceBrush}" Title="NYRI — шторка" Width="436" Height="660" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" Loaded="Window_Loaded" Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Style="{DynamicResource ShellCardStyle}" Padding="20" Margin="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <DockPanel Margin="0,0,0,18"><TextBlock x:Name="GreetingText" Style="{DynamicResource TitleLargeTextStyle}"/><Button DockPanel.Dock="Right" Content="×" Style="{DynamicResource ShellIconButtonStyle}" Click="Close_Click" HorizontalAlignment="Right"/></DockPanel>
                <TextBlock x:Name="NetworkText" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
                <UniformGrid Columns="2" Margin="-4,0">
                    <Button Content="Wi-Fi Windows" Tag="ms-settings:network-wifi" Style="{DynamicResource ShellTileButtonStyle}" Click="SystemSettings_Click"/>
                    <Button Content="Bluetooth Windows" Tag="ms-settings:bluetooth" Style="{DynamicResource ShellTileButtonStyle}" Click="SystemSettings_Click"/>
                    <Button Content="Звук Windows" Tag="ms-settings:sound" Style="{DynamicResource ShellTileButtonStyle}" Click="SystemSettings_Click"/>
                    <Button Content="Питание Windows" Tag="ms-settings:powersleep" Style="{DynamicResource ShellTileButtonStyle}" Click="SystemSettings_Click"/>
                    <Button Content="Микрофон · доступ" Tag="ms-settings:privacy-microphone" Style="{DynamicResource ShellTileButtonStyle}" Click="SystemSettings_Click"/>
                    <Button Content="Камера · доступ" Tag="ms-settings:privacy-webcam" Style="{DynamicResource ShellTileButtonStyle}" Click="SystemSettings_Click"/>
                </UniformGrid>
                <Border Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="20" Padding="16" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Звук" Style="{DynamicResource TitleMediumTextStyle}"/>
                        <TextBlock x:Name="OutputNameText" Text="Устройство вывода" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,4"/>
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                    IsEnabled="False" Foreground="{DynamicResource PrimaryBrush}" MinHeight="32" Margin="0,0,12,0"
                                    VerticalAlignment="Center" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0"
                                    ValueChanged="Volume_ValueChanged" AutomationProperties.Name="Громкость основного устройства вывода"/>
                            <TextBlock x:Name="VolumeText" Grid.Column="1" Text="—" MinWidth="40" VerticalAlignment="Center"
                                       TextAlignment="Right" Style="{DynamicResource LabelMediumTextStyle}"/>
                        </Grid>
                        <Button x:Name="OutputMuteButton" Content="Звук недоступен" IsEnabled="False"
                                Style="{DynamicResource TonalButtonStyle}" Click="OutputMute_Click" Padding="12,8"/>
                        <TextBlock Text="Микрофон по умолчанию" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,14,0,6"/>
                        <Button x:Name="MicrophoneMuteButton" Content="Микрофон не найден" IsEnabled="False"
                                Style="{DynamicResource ShellButtonStyle}" Click="MicrophoneMute_Click" Padding="12,8"
                                ToolTip="Управление основным устройством записи Windows"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Сейчас" Style="{DynamicResource TitleMediumTextStyle}" Margin="0,22,0,10"/>
                <ItemsControl x:Name="ActivityList">
                    <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="20" Padding="14,10" Margin="0,0,0,6"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="MediaControls" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8" Visibility="Collapsed">
                    <Button Content="⏮" Style="{DynamicResource MediaButtonStyle}" Click="Previous_Click" ToolTip="Предыдущий трек"/>
                    <Button Content="⏯" Style="{DynamicResource MediaButtonStyle}" Click="Play_Click" ToolTip="Воспроизвести или поставить на паузу"/>
                    <Button Content="⏭" Style="{DynamicResource MediaButtonStyle}" Click="Next_Click" ToolTip="Следующий трек"/>
                </StackPanel>
                <TextBlock Text="Время" Style="{DynamicResource TitleMediumTextStyle}" Margin="0,16,0,10"/>
                <UniformGrid Columns="3" Margin="-3,0">
                    <Button Content="Таймер 5м" Style="{DynamicResource TonalButtonStyle}" Padding="8,10" FontSize="13" Margin="3,0" Click="Timer_Click"/>
                    <Button Content="Секундомер" Style="{DynamicResource ShellButtonStyle}" Padding="8,10" FontSize="13" Margin="3,0" Click="Stopwatch_Click"/>
                    <Button Content="Стоп" Style="{DynamicResource ShellButtonStyle}" Padding="8,10" FontSize="13" Margin="3,0" Click="Stop_Click"/>
                </UniformGrid>
                <Button Content="Настройки оболочки" Style="{DynamicResource FilledButtonStyle}" Click="Settings_Click" Margin="0,20,0,0"/>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
