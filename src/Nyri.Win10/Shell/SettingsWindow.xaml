<Window x:Class="Nyri.Win10.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource ShellWindowStyle}"
        Title="Настройки NYRI" Width="900" Height="650" MinWidth="680" MinHeight="520"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource OnSurfaceBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,24,0">
            <TextBlock Text="NYRI" Style="{DynamicResource DisplaySmallTextStyle}" Margin="0,8,0,18"/>
            <TextBlock Text="Оформление и оболочка" Style="{DynamicResource TitleMediumTextStyle}" TextWrapping="Wrap"/>
            <TextBlock Text="Единая тема для панели, поиска, дока и шторки." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,24"/>
            <Button Content="Шторка" Style="{DynamicResource TonalButtonStyle}" Click="Control_Click" Margin="0,0,0,8"/>
            <Button Content="Поиск приложений" Style="{DynamicResource ShellButtonStyle}" Click="Search_Click" Margin="0,0,0,8"/>
            <Button Content="Обои" Style="{DynamicResource ShellButtonStyle}" Click="Wallpaper_Click" Margin="0,0,0,8"/>
            <Button Content="Выход из NYRI" Style="{DynamicResource OutlinedButtonStyle}" Click="Exit_Click" Margin="0,24,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Оформление" Style="{DynamicResource HeadlineMediumTextStyle}" Margin="0,8,0,20"/>
                <Border Style="{DynamicResource ShellCardStyle}" Padding="20" Margin="0,0,0,12"><StackPanel>
                    <TextBlock Text="Тема" Style="{DynamicResource TitleMediumTextStyle}"/>
                    <CheckBox x:Name="DarkCheck" Content="Тёмная тема" Margin="0,14,0,16" Foreground="{DynamicResource OnSurfaceBrush}" Checked="Theme_Changed" Unchecked="Theme_Changed"/>
                    <TextBlock Text="Палитра" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                    <ComboBox x:Name="PaletteBox" SelectedValuePath="Tag" SelectionChanged="Theme_Changed" Padding="10">
                        <ComboBoxItem Content="Терракота" Tag="terracotta"/><ComboBoxItem Content="Сирень" Tag="purple"/><ComboBoxItem Content="Океан" Tag="ocean"/>
                    </ComboBox>
                </StackPanel></Border>
                <Border Style="{DynamicResource ShellCardStyle}" Padding="20" Margin="0,0,0,12"><StackPanel>
                    <TextBlock Text="Панель и док" Style="{DynamicResource TitleMediumTextStyle}"/>
                    <TextBlock Text="Расположение панели" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,8"/>
                    <ComboBox x:Name="PositionBox" SelectedValuePath="Tag" SelectionChanged="Position_Changed" Padding="10"><ComboBoxItem Content="Сверху" Tag="top"/><ComboBoxItem Content="Снизу" Tag="bottom"/></ComboBox>
                    <CheckBox x:Name="DockCheck" Content="Показывать док" Foreground="{DynamicResource OnSurfaceBrush}" Margin="0,16,0,0" Checked="Dock_Changed" Unchecked="Dock_Changed"/>
                    <CheckBox x:Name="WidgetsCheck" Content="Виджеты рабочего стола" Foreground="{DynamicResource OnSurfaceBrush}" Margin="0,16,0,0" Checked="Widgets_Changed" Unchecked="Widgets_Changed"/>
                </StackPanel></Border>
                <Border Style="{DynamicResource ShellCardStyle}" Padding="20"><StackPanel>
                    <TextBlock Text="Клавиши" Style="{DynamicResource TitleMediumTextStyle}"/>
                    <TextBlock Text="Ctrl + Alt + Space — поиск&#xA;Ctrl + Alt + N — шторка&#xA;Ctrl + Alt + I — настройки&#xA;Ctrl + Alt + Q — выход&#xA;Esc — закрыть открытую панель" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="25"/>
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
