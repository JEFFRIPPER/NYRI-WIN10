<Window x:Class="Nyri.Win10.Shell.WallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource ShellWindowStyle}"
        Title="NYRI — обои" Width="920" Height="700" MinWidth="600" MinHeight="480"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource OnSurfaceBrush}" Loaded="Window_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <DockPanel Margin="0,0,0,18">
                <TextBlock Text="Обои" Style="{DynamicResource HeadlineMediumTextStyle}"/>
                <Button Content="Применить" Style="{DynamicResource FilledButtonStyle}" Click="Apply_Click" HorizontalAlignment="Right"/>
            </DockPanel>
            <Border CornerRadius="28" ClipToBounds="True" Background="{DynamicResource SurfaceContainerBrush}">
                <Image x:Name="PreviewImage" Height="340" Stretch="UniformToFill"/>
            </Border>
            <TextBlock Text="Стиль" Style="{DynamicResource TitleMediumTextStyle}" Margin="0,22,0,10"/>
            <UniformGrid Columns="2">
                <Button Tag="bauhaus" Click="Style_Click" Style="{DynamicResource TonalButtonStyle}" Margin="0,0,8,0" HorizontalContentAlignment="Left" Padding="18,12">
                    <StackPanel><TextBlock Text="Bauhaus" FontWeight="SemiBold"/><TextBlock Text="Геометрия из оригинального Nyri" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                </Button>
                <Button Tag="waves" Click="Style_Click" Style="{DynamicResource TonalButtonStyle}" HorizontalContentAlignment="Left" Padding="18,12">
                    <StackPanel><TextBlock Text="Волны" FontWeight="SemiBold"/><TextBlock Text="Плавные полосы в цветах палитры" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                </Button>
            </UniformGrid>
            <TextBlock Text="Палитра" Style="{DynamicResource TitleMediumTextStyle}" Margin="0,22,0,10"/>
            <UniformGrid Columns="3">
                <Button Content="Терракота" Tag="terracotta" Background="#E97A2F" Foreground="#29130A" Style="{DynamicResource FilledButtonStyle}" Margin="0,0,8,0" Click="Palette_Click"/>
                <Button Content="Сирень" Tag="purple" Background="#B29ACF" Foreground="#332C50" Style="{DynamicResource FilledButtonStyle}" Margin="0,0,8,0" Click="Palette_Click"/>
                <Button Content="Океан" Tag="ocean" Background="#A3D4CA" Foreground="#153F47" Style="{DynamicResource FilledButtonStyle}" Click="Palette_Click"/>
            </UniformGrid>
            <TextBlock x:Name="SelectionText" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0"/>
            <TextBlock x:Name="StatusText" Text="Применить — установить обои Windows и соответствующую палитру оболочки." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
